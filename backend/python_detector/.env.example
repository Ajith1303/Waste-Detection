# Python Detector service config (copied by the service process).
# The Node backend does NOT read these - they drive the Python ML layer.
# See README.md for the full list.

# Which ML backend runs inside the Python service:
#   yolo      (RECOMMENDED) -> YOLOv8 via ultralytics + ByteTrack + movement
#   roboflow  (default)     -> hosted inference
#   local                   -> raw ONNX YOLO model, fully offline
DETECTOR_BACKEND=yolov8

# --- YOLOv8 + tracking (used when DETECTOR_BACKEND=yolov8) --------------------
# Active model: YOLO-World open-vocabulary (detects any waste-like object from
# the vocabulary without training). Build with OPEN_VOCABULARY=1.
LOCAL_MODEL_PATH=yolov8s-worldv2.pt
# 1 = run the model in open-vocabulary mode with the prompt classes from WASTE_CLASSES.
OPEN_VOCABULARY=1
# Optional comma-separated class filter.
LOCAL_NAMES=
# ByteTrack + movement tracking on/off (1/0).
ENABLE_TRACKING=1
# Position history length per tracked object.
TRACK_HISTORY=30
# Confidence threshold for YOLO detections (0..1). 0.25 is the recommended
# starting point for open-vocabulary (YOLO-World) models.
ROBOFLOW_CONFIDENCE=0.25

# --- Open-vocabulary vocabulary + temporal engine settings --------------------
# Person is always included; add every waste descriptor you want detected.
WASTE_CLASSES=garbage,trash_bag,plastic_bag,waste
# Minimum seconds waste must remain stationary before confirming dumping.
STATIONARY_DURATION_SEC=5.0
# Max normalized distance to consider a person near a waste object.
PROXIMITY_THRESHOLD=0.22
# Min normalized distance a person must move away to confirm departure.
LEAVE_DISTANCE_THRESHOLD=0.35
# Max allowed drift (normalized) for an object to be considered stationary.
STATIONARY_DRIFT_TOL=0.045
# Seconds of detection loss before a stationary waste object is considered removed.
WASTE_DISAPPEAR_TIMEOUT=8.0
# Cooldown minutes to suppress repeated alerts for the same dumped object.
COOLDOWN_MINUTES=15.0
# Spatial radius (normalized) for deduplication of stationary dumps.
SPATIAL_COOLDOWN_RADIUS=0.08
# Save evidence video clips (1=yes, 0=no).
SAVE_EVIDENCE_VIDEO=1

# --- Roboflow hosted inference (used when DETECTOR_BACKEND=roboflow) -----------
# ROBOFLOW_MODE=model                 # model | workflow
# ROBOFLOW_API_KEY=YOUR_A5OTX_ACCOUNT_KEY
# ROBOFLOW_WORKSPACE=
# ROBOFLOW_MODEL_ID=illegal-dumping-detection-a5otx/1

# Port the service listens on (node posts frames here)
PYTHON_DETECTOR_PORT=8001

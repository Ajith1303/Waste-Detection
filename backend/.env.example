# ============================================================
# Smart Waste Dumping Detection & Alert System - Backend config
# Copy this file to '.env' and fill in what you have.
# ============================================================

PORT=5000

# ---- Roboflow Hosted Inference API --------------------------
# ROBOFLOW_MODE selects the detection backend:
#   python    -> Python microservice (RECOMMENDED) - see python_detector/README.md
#   model     -> classic hosted model endpoint (ROBOFLOW_MODEL_ID)
#   workflow  -> SAM 3 zero-shot segmentation via the Workflows HTTP API (no training needed)
#   mock      -> fabricated detections (demo, no API cost)
ROBOFLOW_MODE=python
ROBOFLOW_API_KEY=U0rF7rZmibhiJfop7KGb

# --- Used when ROBOFLOW_MODE=model ------------------------------------------
# AFTER TRAINING your own dataset (see backend/TRAINING_GUIDE.md):
#   Roboflow -> your project -> "Train" -> then Deploy / Use this Model.
#   ROBOFLOW_MODEL_ID = <project>/<version>   e.g. illegal-dumping-detection-qr1g1/1
#   (for shared/other-workspace models add the workspace:
#    <workspace>/<project>/<version> with the legacy endpoint)
# You can also use a PUBLIC model from Roboflow Universe the same way.
# For the serverless endpoint  https://serverless.roboflow.com/<project>/<version>
#    -> ROBOFLOW_MODEL_ID=<project>/<version>
# For the legacy endpoint     https://detect.roboflow.com/<workspace>/<project>/<version>
#    -> ROBOFLOW_MODEL_ID=<workspace>/<project>/<version>  and ROBOFLOW_ENDPOINT=legacy
ROBOFLOW_MODEL_ID=illegal-dumping-detection-qr1g1/1
ROBOFLOW_ENDPOINT=serverless        # serverless | legacy

# --- Used when ROBOFLOW_MODE=workflow ---------------------------------------
# A SAM 3 (or any) workflow from Roboflow -> Workflows -> HTTP API.
# Requires a workspace + workflow id + comma-separated SAM class prompts.
ROBOFLOW_WORKSPACE=ajith-m-jqkia
ROBOFLOW_WORKFLOW_ID=general-segmentation-api-6
ROBOFLOW_WORKFLOW_CLASSES=person,garbage,trash,waste,plastic,bottle,paper,dog,cat,car
ROBOFLOW_WORKFLOW_CONFIDENCE=0.3

# Mock mode: lets the whole prototype run end-to-end WITHOUT any API key.
# It fabricates waste detections so you can demo every classification.
# 1 = enabled, 0 = disabled (use real Roboflow).
# Only used when ROBOFLOW_MODE=mock (or model without a key / MOCK_DETECTION=1).
MOCK_DETECTION=1
# Optional: force one scenario for the mock detector
# (empty/random = varied feed).  Values: random|correct|full|illegal|near|none
MOCK_SCENARIO=random
# Acceptance threshold for detections (0..1)
ROBOFLOW_CONFIDENCE=0.45

# ---- Python Detector Microservice ---------------------------
# Only used when ROBOFLOW_MODE=python.  See python_detector/README.md.
# Start the Python service first:  python detector.py
PYTHON_DETECTOR_URL=http://127.0.0.1:8001/detect
# Backend inside the Python service: roboflow (hosted) | local (ONNX/ultralytics)
DETECTOR_BACKEND=roboflow
# For local mode (ONNX YOLO):  export your trained Roboflow model to ONNX.
# LOCAL_MODEL_PATH=path/to/model.onnx
# LOCAL_NAMES=garbage,person,...

# ---- Email (Nodemailer) -------------------------------------
# MAIL_MODE=console -> prints emails to the terminal (no config needed)
# MAIL_MODE=smtp    -> really sends via SMTP (e.g. Gmail app password)
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=210824205003@kingsedu.ac.in
SMTP_PASS=uldb afsj zzpe sfyv
MAIL_FROM="Smart Waste Alert 210824205003@kingsedu.ac.in"

# ---- SMS (OPTIONAL - India DLT disclaimer) ------------------
# SMS needs DLT registration in India for transactional templates.
# Prototype defaults to console logging. Fast2SMS integration included.
MAIL_MODE_CONTINUED=see above
SMS_MODE=console            # console | fast2sms
FAST2SMS_API_KEY=

# ---- Misc ---------------------------------------------------
# Don't alert twice about the same thing within X minutes
NOTIFY_COOLDOWN_MINUTES=30